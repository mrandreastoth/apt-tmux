#!/usr/bin/env bash
# apt-tmux — tmux session manager
#
# Commands:
#   (no args)                    Open the interactive session manager
#   new [name] [-- cmd...]       New session; collision handling if name exists
#   attach [name]                Attach to session; picker if name omitted
#   kill [name]                  Kill session; picker if name omitted
#   rename [old] [new]           Rename session; picker if old omitted
#   replace [name] [-- cmd...]   Kill existing (if any) and create fresh
#   list                         List sessions (scriptable, one per line)
#   manage                       Interactive session manager (default)
#   auto                         Smart attach: new if none, attach if one, pick if many
#
# Flag (attach, kill, rename, and no-args mode):
#   --no-pick    Fail with an error instead of showing an interactive picker
#
# Shebang usage — create an executable script with #!/usr/bin/env apt-tmux:
#   #apt:session=name        Session name (default: script filename without extension)
#   #apt:on-exists=VALUE     attach | new | replace | kill | ask  (default: ask)
#   #apt:on-missing=VALUE    create | error | ask                 (default: create)
#   (first non-comment line) Command to run when creating a new session

set -euo pipefail

SELF="$(basename "${BASH_SOURCE[0]}")"

# ── tmux helpers ─────────────────────────────────────────────────────────────

tmux_list() {
    tmux list-sessions -F '#{session_name}' 2>/dev/null || true
}

tmux_count() {
    tmux_list | grep -c . 2>/dev/null || echo 0
}

tmux_exists() {
    tmux has-session -t "$1" 2>/dev/null
}

# Create a new tmux session and attach.
# Usage: do_new name [cmd args...]  (name may be empty for auto-name)
do_new() {
    local name="$1"; shift
    local -a args=("new-session")
    [[ -n "$name" ]] && args+=(-s "$name")
    [[ $# -gt 0 ]] && args+=("$@")
    tmux "${args[@]}"
}

# ── interactive ──────────────────────────────────────────────────────────────

# Display a numbered session list and return the chosen session name.
#
# The session list is captured into a local array at call time. All input
# resolution uses that snapshot — never a fresh tmux query. Pressing 'r'
# re-snapshots and redraws in place; the caller never sees REFRESH.
#
# Redraws in place using ANSI escape codes. On quit or valid selection the
# menu is erased before returning, leaving a clean terminal.
#
# Prints to stdout: a session name | "NEW" | "" (quit)
pick_session() {
    local include_new="${1:-false}"
    local prev_lines=0
    local needs_snapshot=true
    local -a sessions=()
    local count=0

    while true; do
        # Re-snapshot when first called or after refresh
        if [[ "$needs_snapshot" == true ]]; then
            sessions=()
            while IFS= read -r s; do
                [[ -n "$s" ]] && sessions+=("$s")
            done < <(tmux_list)
            count=${#sessions[@]}
            needs_snapshot=false
        fi

        # Lines drawn: blank + "Sessions:" + count + blank + [n)] + r) + q) + blank + prompt
        local extra=0
        [[ "$include_new" == true ]] && extra=1
        local menu_lines=$(( count + 7 + extra ))

        if [[ $prev_lines -gt 0 ]]; then
            # Clear previous draw (move up prev_lines, clear to end of screen)
            printf '\033[%dA\033[J' "$prev_lines" >&2
        else
            # First draw: pre-reserve vertical space so the first Enter doesn't
            # scroll the terminal and shift the menu up by one line.
            local j
            for ((j = 0; j < menu_lines; j++)); do printf '\n' >&2; done
            printf '\033[%dA' "$menu_lines" >&2
        fi
        prev_lines=$menu_lines

        # Draw
        echo >&2
        echo "Sessions:" >&2
        local i
        for ((i = 0; i < count; i++)); do
            printf '  %d) %s\n' "$((i + 1))" "${sessions[$i]}" >&2
        done
        echo >&2
        [[ "$include_new" == true ]] && echo "  n) New session" >&2
        echo "  r) Refresh" >&2
        echo "  q) Quit" >&2
        echo >&2

        local choice hint="1-$count"
        [[ "$include_new" == true ]] && hint="$hint, n"
        hint="$hint, r, q"

        read -rp "[$hint]: " choice </dev/tty
        case "$choice" in
            q|Q)
                printf '\033[%dA\033[J' "$menu_lines" >&2
                echo ""; return ;;
            r|R)
                needs_snapshot=true; continue ;;
            n|N)
                if [[ "$include_new" == true ]]; then
                    printf '\033[%dA\033[J' "$menu_lines" >&2
                    echo "NEW"; return
                fi ;;
        esac
        if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= count)); then
            printf '\033[%dA\033[J' "$menu_lines" >&2
            echo "${sessions[$((choice - 1))]}"; return
        fi
        # Invalid input: loop redraws in place (no re-snapshot)
    done
}

# Display a static action menu for a named session.
# Redraws in place on invalid input; erases menu before returning.
# Prints to stdout: "attach" | "rename" | "replace" | "kill" | "back" | "" (quit)
pick_action() {
    local name="$1"
    # Lines: blank + Session: + 6 actions + blank + prompt = 10
    local menu_lines=10
    local prev_lines=0

    while true; do
        if [[ $prev_lines -gt 0 ]]; then
            printf '\033[%dA\033[J' "$prev_lines" >&2
        else
            local j
            for ((j = 0; j < menu_lines; j++)); do printf '\n' >&2; done
            printf '\033[%dA' "$menu_lines" >&2
        fi
        prev_lines=$menu_lines

        echo >&2
        echo "Session: $name" >&2
        echo "  a) Attach" >&2
        echo "  n) Rename" >&2
        echo "  r) Replace (kill and recreate)" >&2
        echo "  k) Kill" >&2
        echo "  b) Back" >&2
        echo "  q) Quit" >&2
        echo >&2

        local choice
        read -rp "[a, n, r, k, b, q]: " choice </dev/tty
        case "$choice" in
            a|A) printf '\033[%dA\033[J' "$menu_lines" >&2; echo "attach";  return ;;
            n|N) printf '\033[%dA\033[J' "$menu_lines" >&2; echo "rename";  return ;;
            r|R) printf '\033[%dA\033[J' "$menu_lines" >&2; echo "replace"; return ;;
            k|K) printf '\033[%dA\033[J' "$menu_lines" >&2; echo "kill";    return ;;
            b|B) printf '\033[%dA\033[J' "$menu_lines" >&2; echo "back";    return ;;
            q|Q) printf '\033[%dA\033[J' "$menu_lines" >&2; echo "";        return ;;
        esac
        # Invalid input: loop redraws in place
    done
}

# Prompt what to do when a named session already exists.
# Redraws in place on invalid input; does NOT erase on valid selection
# (the caller will immediately act on the result).
# Prints: attach | replace | kill | new | quit
collision_prompt() {
    local name="$1"
    # Lines: blank + header + 5 options + blank + prompt = 9
    local menu_lines=9
    local prev_lines=0

    while true; do
        if [[ $prev_lines -gt 0 ]]; then
            printf '\033[%dA\033[J' "$prev_lines" >&2
        else
            local j
            for ((j = 0; j < menu_lines; j++)); do printf '\n' >&2; done
            printf '\033[%dA' "$menu_lines" >&2
        fi
        prev_lines=$menu_lines

        echo >&2
        echo "Session '$name' already exists." >&2
        echo "  a) Attach" >&2
        echo "  r) Replace (kill and recreate)" >&2
        echo "  k) Kill (and exit)" >&2
        echo "  n) New (choose a different name)" >&2
        echo "  q) Quit" >&2
        echo >&2

        local choice
        read -rp "[a, r, k, n, q]: " choice </dev/tty
        case "$choice" in
            a|A) printf '\033[%dA\033[J' "$menu_lines" >&2; echo "attach";  return ;;
            r|R) printf '\033[%dA\033[J' "$menu_lines" >&2; echo "replace"; return ;;
            k|K) printf '\033[%dA\033[J' "$menu_lines" >&2; echo "kill";    return ;;
            n|N) printf '\033[%dA\033[J' "$menu_lines" >&2; echo "new";     return ;;
            q|Q) printf '\033[%dA\033[J' "$menu_lines" >&2; echo "quit";    return ;;
        esac
        # Invalid input: loop redraws in place
    done
}

# ── argument parsing ──────────────────────────────────────────────────────────

# Parse "new/replace" args: [name] [-- cmd...]
# Sets _NAME and _CMD (array) in the caller's scope.
parse_new_args() {
    _NAME=""
    _CMD=()
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == "--" ]]; then
            shift; _CMD=("$@"); return
        fi
        [[ -z "$_NAME" ]] && _NAME="$1"
        shift
    done
}

# ── shared helpers ────────────────────────────────────────────────────────────

_do_rename() {
    local old="$1" new="$2"
    tmux rename-session -t "$old" "$new"
    echo "Renamed: $old → $new" >&2
}

# ── commands ─────────────────────────────────────────────────────────────────

cmd_new() {
    local _NAME _CMD
    parse_new_args "$@"
    local name="$_NAME"
    local -a cmd=("${_CMD[@]}")

    if [[ -n "$name" ]] && tmux_exists "$name"; then
        local action
        action="$(collision_prompt "$name")"
        case "$action" in
            attach)
                tmux attach-session -t "$name" ;;
            replace)
                tmux kill-session -t "$name"
                do_new "$name" "${cmd[@]}" ;;
            kill)
                tmux kill-session -t "$name"
                echo "Killed: $name" >&2 ;;
            new)
                local newname
                read -rp "Session name: " newname </dev/tty
                [[ -z "$newname" ]] && { echo "Cancelled." >&2; return; }
                do_new "$newname" "${cmd[@]}" ;;
            quit)
                echo "Cancelled." >&2 ;;
        esac
        return
    fi

    do_new "$name" "${cmd[@]}"
}

cmd_attach() {
    local no_pick=false
    [[ "${1:-}" == "--no-pick" ]] && { no_pick=true; shift; }
    local name="${1:-}"

    if [[ -n "$name" ]]; then
        tmux_exists "$name" || { echo "No session: $name" >&2; exit 1; }
        tmux attach-session -t "$name"
        return
    fi

    local count
    count="$(tmux_count)"
    case "$count" in
        0) echo "No sessions." >&2; exit 1 ;;
        1) tmux attach-session; return ;;
    esac

    if [[ "$no_pick" == true ]]; then
        echo "Multiple sessions exist. Specify a name." >&2; exit 1
    fi

    local selected
    selected="$(pick_session false)"
    [[ -z "$selected" ]] && { echo "Cancelled." >&2; return; }
    tmux attach-session -t "$selected"
}

cmd_kill() {
    local no_pick=false
    [[ "${1:-}" == "--no-pick" ]] && { no_pick=true; shift; }
    local name="${1:-}"

    if [[ -n "$name" ]]; then
        tmux_exists "$name" || { echo "No session: $name" >&2; exit 1; }
        tmux kill-session -t "$name"
        echo "Killed: $name" >&2
        return
    fi

    local count
    count="$(tmux_count)"
    case "$count" in
        0) echo "No sessions." >&2; exit 1 ;;
        1)
            local only
            only="$(tmux_list)"
            tmux kill-session -t "$only"
            echo "Killed: $only" >&2
            return ;;
    esac

    if [[ "$no_pick" == true ]]; then
        echo "Multiple sessions exist. Specify a name." >&2; exit 1
    fi

    local selected
    selected="$(pick_session false)"
    [[ -z "$selected" ]] && { echo "Cancelled." >&2; return; }
    tmux kill-session -t "$selected"
    echo "Killed: $selected" >&2
}

cmd_rename() {
    local no_pick=false
    [[ "${1:-}" == "--no-pick" ]] && { no_pick=true; shift; }
    local old="${1:-}" new="${2:-}"

    if [[ -z "$old" ]]; then
        local count
        count="$(tmux_count)"
        case "$count" in
            0) echo "No sessions." >&2; exit 1 ;;
            1) old="$(tmux_list)" ;;
            *)
                if [[ "$no_pick" == true ]]; then
                    echo "Multiple sessions exist. Specify a name." >&2; exit 1
                fi
                old="$(pick_session false)"
                [[ -z "$old" ]] && { echo "Cancelled." >&2; return; } ;;
        esac
    else
        tmux_exists "$old" || { echo "No session: $old" >&2; exit 1; }
    fi

    if [[ -z "$new" ]]; then
        read -rp "New name for '$old': " new </dev/tty
        [[ -z "$new" ]] && { echo "Cancelled." >&2; return; }
    fi

    _do_rename "$old" "$new"
}

cmd_replace() {
    local _NAME _CMD
    parse_new_args "$@"
    local name="$_NAME"
    local -a cmd=("${_CMD[@]}")

    if [[ -n "$name" ]] && tmux_exists "$name"; then
        tmux kill-session -t "$name"
    fi
    do_new "$name" "${cmd[@]}"
}

cmd_list() {
    local count
    count="$(tmux_count)"
    if [[ "$count" -eq 0 ]]; then
        echo "No sessions."
        return
    fi
    tmux_list
}

cmd_auto() {
    local no_pick=false
    [[ "${1:-}" == "--no-pick" ]] && no_pick=true

    local count
    count="$(tmux_count)"
    case "$count" in
        0) tmux new-session; return ;;
        1) tmux attach-session; return ;;
    esac

    if [[ "$no_pick" == true ]]; then
        echo "Multiple sessions exist. Specify a command and session name." >&2; exit 1
    fi

    local selected
    selected="$(pick_session true)"
    case "$selected" in
        "")  echo "Cancelled." >&2; return ;;
        NEW)
            local newname
            read -rp "Session name (blank for auto): " newname </dev/tty
            do_new "$newname"
            return ;;
        *)   tmux attach-session -t "$selected"; return ;;
    esac
}

cmd_manage() {
    while true; do
        local count
        count="$(tmux_count)"
        if [[ "$count" -eq 0 ]]; then
            echo "No sessions." >&2
            return
        fi

        local selected
        selected="$(pick_session true)"
        case "$selected" in
            "") return ;;
            NEW)
                local newname
                read -rp "Session name (blank for auto): " newname </dev/tty
                local -a new_args=("new-session" "-d")
                [[ -n "$newname" ]] && new_args+=(-s "$newname")
                tmux "${new_args[@]}"
                continue ;;
            *)
                local action
                action="$(pick_action "$selected")"
                case "$action" in
                    attach)
                        tmux attach-session -t "$selected"
                        return ;;
                    rename)
                        local newname
                        read -rp "New name for '$selected': " newname </dev/tty
                        if [[ -n "$newname" ]]; then
                            _do_rename "$selected" "$newname"
                        else
                            echo "Cancelled." >&2
                        fi
                        continue ;;
                    replace)
                        tmux kill-session -t "$selected"
                        do_new "$selected"
                        return ;;
                    kill)
                        tmux kill-session -t "$selected"
                        echo "Killed: $selected" >&2
                        continue ;;
                    back|"")
                        continue ;;
                esac ;;
        esac
    done
}

cmd_script() {
    local file="$1"
    [[ -f "$file" ]] || { echo "File not found: $file" >&2; exit 1; }

    local session_name="" on_exists="" on_missing="" cmd=""

    while IFS= read -r line; do
        case "$line" in
            '#apt:session='*)   session_name="${line#'#apt:session='}" ;;
            '#apt:on-exists='*) on_exists="${line#'#apt:on-exists='}" ;;
            '#apt:on-missing='*)on_missing="${line#'#apt:on-missing='}" ;;
            '#'* | '')          continue ;;
            *)                  [[ -z "$cmd" ]] && cmd="$line" ;;
        esac
    done < "$file"

    [[ -z "$session_name" ]] && session_name="$(basename "$file")"
    session_name="${session_name%.*}"

    [[ -z "$on_exists" ]]  && on_exists="ask"
    [[ -z "$on_missing" ]] && on_missing="create"

    local -a run_cmd=()
    [[ -n "$cmd" ]] && run_cmd=(bash -c "$cmd")

    if tmux_exists "$session_name"; then
        case "$on_exists" in
            attach)
                tmux attach-session -t "$session_name" ;;
            replace)
                tmux kill-session -t "$session_name"
                do_new "$session_name" "${run_cmd[@]}" ;;
            kill)
                tmux kill-session -t "$session_name"
                echo "Killed: $session_name" >&2 ;;
            new)
                local newname
                read -rp "Session name: " newname </dev/tty
                [[ -z "$newname" ]] && { echo "Cancelled." >&2; return; }
                do_new "$newname" "${run_cmd[@]}" ;;
            ask)
                local action
                action="$(collision_prompt "$session_name")"
                case "$action" in
                    attach)  tmux attach-session -t "$session_name" ;;
                    replace) tmux kill-session -t "$session_name"
                             do_new "$session_name" "${run_cmd[@]}" ;;
                    kill)    tmux kill-session -t "$session_name"
                             echo "Killed: $session_name" >&2 ;;
                    new)
                        local newname2
                        read -rp "Session name: " newname2 </dev/tty
                        [[ -z "$newname2" ]] && { echo "Cancelled." >&2; return; }
                        do_new "$newname2" "${run_cmd[@]}" ;;
                    quit) echo "Cancelled." >&2 ;;
                esac ;;
            *)  echo "Unknown on-exists value: $on_exists" >&2; exit 1 ;;
        esac
    else
        case "$on_missing" in
            create) do_new "$session_name" "${run_cmd[@]}" ;;
            error)  echo "No session: $session_name" >&2; exit 1 ;;
            ask)
                local choice
                read -rp "Session '$session_name' does not exist. Create? [y/n]: " choice </dev/tty
                if [[ "$choice" =~ ^[yY]$ ]]; then
                    do_new "$session_name" "${run_cmd[@]}"
                else
                    echo "Cancelled." >&2
                fi ;;
            *)  echo "Unknown on-missing value: $on_missing" >&2; exit 1 ;;
        esac
    fi
}

usage() {
    cat <<EOF
Usage: $SELF <command> [args]

  (no args)                    Open the interactive session manager
  new [name] [-- cmd...]       New session; collision handling if name exists
  attach [name]                Attach to session; picker if name omitted
  kill [name]                  Kill session; picker if name omitted
  rename [old] [new]           Rename session; picker if old omitted
  replace [name] [-- cmd...]   Kill existing (if any) and create fresh
  list                         List sessions (one per line, scriptable)
  manage                       Interactive session manager (default)
  auto                         Smart attach: new if none, attach if one, pick if many

Flag (attach, kill, rename, no-args):
  --no-pick    Fail with an error instead of showing an interactive picker

Shebang mode — make a script executable with #!/usr/bin/env apt-tmux:
  #apt:session=name        Session name (default: script filename)
  #apt:on-exists=VALUE     attach | new | replace | kill | ask  (default: ask)
  #apt:on-missing=VALUE    create | error | ask                 (default: create)
  (first non-comment line) Command to run in the new session
EOF
    exit 1
}

# ── dispatch ──────────────────────────────────────────────────────────────────

case "${1:-}" in
    new)       shift; cmd_new "$@" ;;
    attach)    shift; cmd_attach "$@" ;;
    kill)      shift; cmd_kill "$@" ;;
    rename)    shift; cmd_rename "$@" ;;
    replace)   shift; cmd_replace "$@" ;;
    list)      cmd_list ;;
    manage)    cmd_manage ;;
    auto)      shift; cmd_auto "$@" ;;
    "")        cmd_manage ;;
    --no-pick) cmd_auto --no-pick ;;
    *)         [[ -f "$1" ]] && cmd_script "$1" || usage ;;
esac
